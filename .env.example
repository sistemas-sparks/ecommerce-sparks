# Use em apps/web/.env.local (só NEXT_PUBLIC_*) e apps/api/.dev.vars (Worker). NUNCA faça commit com valores reais.

# ---- apps/web (público, vai para o navegador) ----
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_STORE_WHATSAPP=
# "true" liga o botão "Entrar com Google" em Minha conta. Só depois do Google ligado no Supabase (T-031/T-038).
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=

# ---- build do site (não vai para o navegador) ----
# <URL da API>/catalog/snapshot. Obrigatória no build de produção; sem ela, usa o catálogo local.
SPARKS_CATALOG_URL=

# ---- apps/api (SECRETOS: wrangler secret put) ----
SITE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
ORDER_TOKEN_PEPPER=
DEPLOY_HOOK_URL=
# Token do Melhor Envio (só cotação). Só como secret do Worker; vazio = só fretes próprios.
MELHOR_ENVIO_TOKEN=
# sandbox (padrão) ou production.
MELHOR_ENVIO_ENV=
# Obrigatório com token: nome da aplicação + e-mail técnico (5 a 200 caracteres).
MELHOR_ENVIO_USER_AGENT=
CHECKOUT_ENABLED=true
