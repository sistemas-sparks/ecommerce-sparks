{
  "name": "@sparks/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/fetch-catalog.mjs && next build && node scripts/normalize-static-segments.mjs && node scripts/harden-export.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
