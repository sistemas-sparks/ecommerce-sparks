    "seo:audit": "node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "@sparks/shared": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.3"
  }
}
